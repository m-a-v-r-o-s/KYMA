# Copy this file to .env.local to configure the site.

# The owner dashboard lives at /admin
NEXT_PUBLIC_ADMIN_PASSWORD=kyma2025

# Stripe, required for instant "Book & pay" checkout.
# Get your secret key at https://dashboard.stripe.com/apikeys
# Use a test key (sk_test_...) while developing.
# If this is unset, the booking form still works via "Request to book".
STRIPE_SECRET_KEY=sk_test_xxx

# Real production domain, used in metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://villakyma.gr

# Analytics (optional). Leave unset to skip loading any analytics script.
# The tracking script only loads for visitors who accept analytics cookies
# in the cookie consent banner. Set this to a real Google Analytics
# Measurement ID (e.g. G-XXXXXXXXXX) when one exists.
NEXT_PUBLIC_GA_ID=
